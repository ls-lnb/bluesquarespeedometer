<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_speedometer_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minWidth="140dp"
    android:minHeight="56dp"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:paddingVertical="4dp"
    android:background="@drawable/overlay_speedometer_background"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/overlay_speedometer_speed_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="-"
            android:textSize="34sp"
            android:textColor="#ffffff"
            android:fontFamily="monospace"
            android:gravity="end" />

        <TextView
            android:id="@+id/overlay_speedometer_unit_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginVertical="4dp"
        android:background="@color/colorAccent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/metrics_altitude_short"
            android:textSize="11sp"
            android:textColor="#b0c4ff" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/overlay_speedometer_altitude_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="-"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:fontFamily="monospace"
                android:gravity="end" />

            <TextView
                android:id="@+id/overlay_speedometer_altitude_unit_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:paddingStart="3dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_speedometer_close_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:text="@string/overlay_close_button"
        android:textSize="16sp"
        android:textColor="#ff8080"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/menu_this_app_overlay_hide" />
</LinearLayout>
