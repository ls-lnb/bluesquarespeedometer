<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".viewers.DigitalSpeedometer1Activity"
    android:background="?backgroundColor"
    android:id="@+id/main"
    android:keepScreenOn="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/car_meter1_root_view"
        android:orientation="vertical"
        android:paddingVertical="3dp"
        android:background="@color/colorAccent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?backgroundColor"
            android:gravity="center_vertical"
            >
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                >
                <TextView
                    android:id="@+id/digital_meter1_textview"
                    android:layout_width="260sp"
                    android:layout_height="wrap_content"
                    android:textSize="112sp"
                    android:textColor="?baseTextColor"
                    android:gravity="end"
                    />
                <TextView
                    android:id="@+id/digital_meter1_unit_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="36sp"
                    android:paddingStart="12sp"
                    android:textColor="?baseTextColor"
                    android:gravity="bottom"
                    />
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/colorAccent"
                android:layout_marginStart="12sp"
                android:layout_marginEnd="12sp"
                android:layout_marginBottom="6sp"
                />
            <LinearLayout
                android:id="@+id/digital_meter1_altitude_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="4sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metrics_altitude_short"
                    android:textSize="24sp"
                    android:textColor="?baseTextColor"
                    android:paddingEnd="16sp"
                    />
                <TextView
                    android:id="@+id/digital_meter1_altitude_textview"
                    android:layout_width="140sp"
                    android:layout_height="wrap_content"
                    android:textSize="48sp"
                    android:textColor="?baseTextColor"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    />
                <TextView
                    android:id="@+id/digital_meter1_altitude_unit_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:paddingStart="8sp"
                    android:textColor="?baseTextColor"
                    />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>