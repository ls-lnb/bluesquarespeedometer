<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_speedometer_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="116dp"
    android:minHeight="56dp"
    android:background="@drawable/overlay_speedometer_background"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="24dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/overlay_speedometer_speed_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="-"
                android:textSize="36sp"
                android:textColor="#ffffff"
                android:fontFamily="monospace"
                android:gravity="end" />

            <TextView
                android:id="@+id/overlay_speedometer_unit_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:paddingStart="4dp"
                android:layout_gravity="bottom" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/overlay_speedometer_altitude_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="34dp"
                android:text="-"
                android:textSize="14sp"
                android:textColor="#c8d4ff"
                android:fontFamily="monospace"
                android:gravity="end" />

            <TextView
                android:id="@+id/overlay_speedometer_altitude_unit_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="10sp"
                android:textColor="#c8d4ff"
                android:paddingStart="3dp"
                android:layout_gravity="bottom" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_speedometer_close_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:padding="6dp"
        android:text="@string/overlay_close_button"
        android:textSize="14sp"
        android:textColor="#ff8080"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/menu_this_app_overlay_hide" />
</FrameLayout>
